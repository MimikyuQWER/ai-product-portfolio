# ============================================
# 地址审核 Agent 配置文件
# 复制此文件为 .env 并填入你的 API Key
# ============================================

# ----- LLM API（必填）-----
# 方案一：DeepSeek（推荐，国内便宜）
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 方案二：OpenAI（取消注释下面三行，注释掉上面三行）
# LLM_API_KEY=sk-your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# ----- 高德地图 API（必填）-----
# 注册地址：https://console.amap.com/
# 创建应用 → 添加 Key → 选择"Web服务"
AMAP_API_KEY=23f710e1bffedd78bce4e1c170605e7c

# ----- 联网搜索 API（可选，不填则只用高德）-----
# 注册地址：https://portal.azure.com/ → 创建 Bing Search 资源
BING_SEARCH_KEY=your-bing-key
