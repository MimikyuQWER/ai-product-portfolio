# ============================================
# 地址审核 Agent 配置文件
# 复制此文件为 .env 并填入你的 API Key
# ============================================

# ----- 🤖 AI API（必填，选一个即可）-----
# 方案一：DeepSeek（推荐，国内直连，注册送 500 万 token）
# 注册地址：https://platform.deepseek.com/
# 注册后在「API Keys」页面创建 Key，粘贴到下方
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 方案二：OpenAI（取消注释下面三行，注释掉上面三行）
# 注册地址：https://platform.openai.com/
# LLM_API_KEY=sk-your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# ----- 🗺️ 高德地图 API（已预配，开箱即用）-----
# 下方为项目预配置的共享 Key，开箱即可使用，无需自行申请。
# 若该 Key 提示不可用 / 配额耗尽，请到 https://lbs.amap.com/ 控制台 → 创建「Web服务」类型 Key，
# 复制后替换本行（或写入你自己的 .env 文件）即可切换为你自己的 Key。
AMAP_API_KEY=23f710e1bffedd78bce4e1c170605e7c

# ----- 🌐 联网搜索 API（可选）-----
# 填了 Bing Key 走 Bing；不填则自动回退到免费 DuckDuckGo 搜索（无需 Key）
# Bing 申请：https://portal.azure.com/ → 创建 Bing Search v7 资源
BING_SEARCH_KEY=your-bing-key
