# ============================================
# 地址审核 Agent 配置文件
# 复制此文件为 .env 并填入你的 AI API Key
# 高德地图 Key 已预配，无需自行申请
# ============================================

# ----- 🤖 AI API（必填，选一个即可）-----
# 方案一：DeepSeek（推荐，国内直连，注册送 500 万 token）
# 注册地址：https://platform.deepseek.com/
# 注册后在「API Keys」页面创建 Key，粘贴到下方
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 方案二：OpenAI（取消注释下面三行，注释掉上面三行）
# 注册地址：https://platform.openai.com/
# LLM_API_KEY=sk-your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# ----- 🗺️ 高德地图 API（已预配，无需修改）-----
# 以下 Key 已配置可用额度，直接使用即可
AMAP_API_KEY=23f710e1bffedd78bce4e1c170605e7c

# ----- 🌐 联网搜索 API（可选，不填则只用高德）-----
# 注册地址：https://portal.azure.com/ → 创建 Bing Search 资源
BING_SEARCH_KEY=your-bing-key
