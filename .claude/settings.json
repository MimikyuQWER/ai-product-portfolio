{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \".claude/hooks/session_start.py\"",
            "timeout": 10,
            "statusMessage": "加载项目记忆…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \".claude/hooks/stop_reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 \".claude/hooks/archive_change.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
